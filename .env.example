# CivicFeed environment variables
# Copy this file to .env and adjust values for your environment.

# Frontend API base URL. Leave empty to use same-origin /api (proxied by Vite/nginx)
# and fall back to http://localhost:4000 in local development.
VITE_API_URL=

# Backend Express server port.
PORT=4000

# Path to the SQLite database used by the backend.
CIVICFEED_DB_PATH=backend/data/civicfeed.db

# Backend log level: error, warn, info, or silent.
CIVICFEED_LOG_LEVEL=info

# Interval in milliseconds between background refreshes of due feeds.
# Set to 0 to disable scheduled refreshes. Default: 60000 (1 minute).
CIVICFEED_REFRESH_INTERVAL_MS=60000
