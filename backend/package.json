{
  "name": "civicfeed-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "seed": "tsx src/db.ts --seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:feeds": "tsx src/validate-feeds.ts",
    "validate:feeds:strict": "tsx src/validate-feeds.ts --strict",
    "ingest": "tsx src/ingest.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "fast-xml-parser": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "supertest": "^7.0.0",
    "tsx": "^4.22.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
